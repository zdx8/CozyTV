# CozyTV Release Keystore Configuration
#
# LOCAL ONLY — this file is .gitignored and must never be committed.
# Copy this template to `keystore.properties` in the repository root and
# fill in the real values.
#
# Generate the keystore (run once; keep the .keystore file backed up
# somewhere outside the repository, e.g. a password manager):
#
#   keytool -genkeypair -v \
#     -keystore app/signing/cozytv-release.keystore \
#     -alias cozytv-release \
#     -keyalg RSA -keysize 4096 -validity 10950 \
#     -storetype PKCS12 \
#     -storepass 'YOUR_STORE_PASSWORD' \
#     -keypass   'YOUR_KEY_PASSWORD' \
#     -dname "CN=CozyTV, OU=zdx8, O=zdx8, L=Beijing, ST=Beijing, C=CN"
#
# `storeFile` accepts a repository-root-relative path
# (app/signing/cozytv-release.keystore) or a module-relative one —
# the build tries both.
#
# NOTE: the releases published before v0.4.0 were signed with the local
# Android debug key. Switching to this key means existing installs
# cannot be updated in place (the signatures differ) — users have to
# uninstall the old version once. See HANDOVER.md §5.
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=cozytv-release
storeFile=app/signing/cozytv-release.keystore
